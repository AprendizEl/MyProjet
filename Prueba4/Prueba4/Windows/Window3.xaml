<Window x:Class="Prueba4.Windows.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prueba4.Windows"
        mc:Ignorable="d"
        Title="Window3" Height="300" Width="400">
    <Grid Background="{StaticResource color2}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="Ingrese cords de los puntos" TextAlignment="Center" VerticalAlignment="Center" FontSize="20" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <TextBlock Text="X cords " Margin="50,0" FontSize="18"/>
                    <TextBlock Text="Y cords " Margin="50,0" FontSize="18"/>
                </StackPanel>

            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBox Margin="45,0" Width="50" Name="C_x" KeyDown="C_x_KeyDown" />
                    <TextBox Margin="45,0" Width="50" Name="C_y"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Content="Guardar" Name="BT_Guardar" Click="Button_Click" Margin="20"/>
                    <Button Content="Cancelar" Name="BT_Cancelar"  Click="Button_Click" Margin="20" />
                    <Button Content="Documentar" Name="BT_Documentar" Margin="20" Click="Button_Click" />
                    <Button Content="Borrar" Name="BT_Borrar" Margin="20" Click="Button_Click" />
                </StackPanel>


            </Grid>



        </Grid>

        <Button Background="Transparent"  Grid.Column="1" Click="Button_Click">
            <Button.Content>
                <TextBlock Text=" > " Name="BT_newT" FontSize="50" Foreground="Black"/>
            </Button.Content>

        </Button>



    </Grid>
</Window>
