<Window x:Class="TheProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheProject"
        xmlns:View="clr-namespace:TheProject.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="365">
    
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Nombre:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Margin="80,0,0,10" Width="200" Text="{Binding model.Name, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" />

        <TextBlock Grid.Row="1" Text="Edad:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Margin="80,0,0,10" Width="200" Text="{Binding model.Age, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" />

        <TextBlock Grid.Row="2" Text="Tipo de Persona:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Margin="80,0,0,10" Width="200 "  HorizontalAlignment="Right"
                  ItemsSource="{Binding PersonalityTypes}" 
                  SelectedItem="{Binding model.PersonalityType, UpdateSourceTrigger=PropertyChanged}" />

        <Button Grid.Row="3" Content="Guardar" Width="100" Height="30" 
                HorizontalAlignment="Right" Command="{Binding SaveCommand}" />

        <Button Grid.Row="3" Content="Guardar" Width="100" Height="30" 
        HorizontalAlignment="Left" Command="{Binding SaveCommand}" />
    </Grid>
</Window>
