                <Border Grid.Row="0" Margin="0,0,0,5" CornerRadius="5">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="Transparent" />
                    </Border.BorderBrush>

                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource primaryBackColor1}" />
                    </Border.Background>
                </Border>

                <Border Grid.Row="1" Margin="0,0,0,5" CornerRadius="5">
                    <Border.BorderBrush>
